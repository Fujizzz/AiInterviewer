# Copy to backend/.env. Never put API keys in browser code or commit backend/.env.
# Existing process environment variables take precedence. Restart after editing.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TEMPERATURE=0

# For Qwen, set LLM_PROVIDER=dashscope and fill both fields below.
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DJANGO_SECRET_KEY is separate from the model API key.
# Supply a randomly generated value here or through the process environment.
# DJANGO_SECRET_KEY=
