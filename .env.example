# Copy to .env in the repository root. Never commit .env or expose keys in browser code.
# Shared by the terminal MVP and Django backend; process environment variables take precedence.
# Restart the backend after editing.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TEMPERATURE=0
# For Alibaba Qwen, set LLM_PROVIDER=dashscope.
# The key may also be supplied by your system environment.
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
# Beijing endpoint; override to match your API key's region.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Interview gateway: true by default; false explicitly suspends safety review for development.
# Restart the backend after changing; authentication/state integrity remain enforced.
AI_SECURITY_ENABLED=true
# Safety-engine pool only: finite idle lifetime, not the 5-second review deadline.
# SDK connection counts and retries remain unchanged; explicit invalid values fail startup.
AI_SECURITY_KEEPALIVE_SECONDS=60

# Parallel rubric evaluation is internal; visible scores stay on the legacy path.
# Apply backend migrations first. Set legacy to disable extra shadow model calls.
EVALUATION_MODE=shadow

# Django application secret, separate from the model API key.
# Generate a random value before starting the backend.
DJANGO_SECRET_KEY=
# Optional absolute SQLite path; defaults to backend/db.sqlite3.
# INTERVIEW_DB_PATH=

# Speech reuses DASHSCOPE_API_KEY with native WebSocket APIs, independently of the LLM HTTP URL.
# Enable after checking access and quota/billing for the chosen speech region in the console.
SPEECH_ENABLED=false
# Allowed: singapore (unchanged default) or beijing. Must match the API key's region.
SPEECH_REGION=singapore
# Optional ASR workspace in SPEECH_REGION; blank uses that region's public endpoint.
DASHSCOPE_SPEECH_WORKSPACE_ID=
SPEECH_TTS_MODEL=qwen-audio-3.0-tts-flash
SPEECH_TTS_VOICE=loongeva_v3.6
SPEECH_STT_MODEL=qwen-audio-3.1-asr-flash-streaming

# Independent facial presentation Agent; consumes approved questions, never scores answers.
# Disabled until enabled explicitly. Blank provider/model reuse LLM_PROVIDER and its model.
# Credentials and base URL are shared. Plans include all four states; no per-frame calls or retries.
PRESENTATION_ENABLED=false
PRESENTATION_PROVIDER=
PRESENTATION_MODEL=
PRESENTATION_TIMEOUT_SECONDS=25

# Independent completion Agent: settled ASR final snapshots go to the lightweight model.
# Coalesce after 0.5s quiet; at most one call at a time and one start per second, no keyword gate.
# Uses DASHSCOPE_API_KEY / DASHSCOPE_BASE_URL, independent of the interview model.
# New defaults: non-thinking Qwen Flash, 3s total API deadline, no retries; silence gate is 3s.
ANSWER_COMPLETION_MODEL=qwen-flash
ANSWER_COMPLETION_TIMEOUT_SECONDS=3
# Explicit offline semantic filter artifact directory (contains manifest/head/encoder/tokenizer).
# Empty selects Qwen-only mode; a configured missing/invalid model is a visible error, no bypass.
ANSWER_COMPLETION_GATE_PATH=

# Optional resume vision Agent (independent of the interview model).
# Explicitly select provider/model; missing configuration is a visible error, no fallback.
# Reuses the selected provider's API_KEY and BASE_URL above.
RESUME_VISION_PROVIDER=
RESUME_VISION_MODEL=
RESUME_VISION_TIMEOUT_SECONDS=90
# DashScope only: set true/false explicitly if the chosen model requires it.
RESUME_VISION_ENABLE_THINKING=

# PDF isolation is required. No in-process fallback if this runtime is unavailable.
# Windows: an installed WSL distribution. Linux: omit PDF_SANDBOX_DISTRO.
PDF_SANDBOX_DISTRO=Ubuntu-24.04
PDF_SANDBOX_RUNTIME=/home/your-user/.local/share/ai-interviewer/pdf-sandbox
PDF_SANDBOX_MEMORY_MIB=768
PDF_SANDBOX_CPU_SECONDS=20
PDF_SANDBOX_WALL_SECONDS=30

# New service admission limits, shared across same-host workers via OS file locks.
# Keep the same capacity directory and values for all workers; do not delete live lock files.
SERVICE_AGENT_CONNECTIONS=4
SERVICE_PDF_UPLOADS=2
# SERVICE_CAPACITY_DIR=/absolute/path/to/shared-capacity-directory

# Explicit job source for recommendations; empty means not configured, with no fallback.
# To use the bundled 100 experience jobs, set their absolute path. They are not live vacancies.
# Example: /absolute/path/to/repo/backend/interviews/recommendation/data/experience-jobs.json
RECOMMENDATION_JOB_CATALOG=

# Remote avatar transport is opt-in. Render on a GPU PC; authenticated browser signalling
# is proxied through the deployed backend. Upstream must stay on loopback.
AVATAR_REMOTE_ENABLED=false
AVATAR_SIGNALLING_UPSTREAM=ws://127.0.0.1:8889
