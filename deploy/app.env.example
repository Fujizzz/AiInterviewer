# 职责：生产环境模板，真实文件位于 /etc/ai-interviewer/app.env，权限 0600。
# 目录：无函数/类。变量索引：DJANGO_* 为应用入口；POSTGRES_* 为数据库；其余见 backend/.env.example。
DJANGO_SETTINGS_MODULE=config.production
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=47.239.50.129,127.0.0.1,localhost
POSTGRES_DB=ai_interviewer
POSTGRES_USER=aiinterviewer
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
PDF_SANDBOX_RUNTIME=/opt/ai-interviewer/pdf-sandbox
SERVICE_CAPACITY_DIR=/var/lib/ai-interviewer/capacity
# 将本地模型配置和既有资源限制复制到真实环境文件；不要提交凭据。
